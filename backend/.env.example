# ============================================================
# Hang MU — BACKEND (Rust/Axum)
# Copy thành `backend/.env` rồi chỉnh. KHÔNG commit `.env`.
# Docker: docker run --env-file backend/.env ...
# ============================================================

# ---- App ----
APP_ENV=development
DOMAIN=localhost
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
RUST_LOG=info,hangmu_backend=debug,tower_http=info
# Dev: chạy tay bằng `npm run migrate` (giống Laravel). Deploy: true để tự chạy khi khởi động.
RUN_MIGRATIONS=false

# ---- Timeout chung cho HTTP API (ms) ----
# PHẢI khớp với API_TIMEOUT_MS trong frontend/.env
API_TIMEOUT_MS=10000

# ---- PostgreSQL 18 ----
# Trong Docker: không dùng localhost (dùng hostname mạng Docker / host.docker.internal)
DATABASE_URL=postgres://hangmu:change_me@localhost:5432/hangmu
# Connection pool
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CONNECTIONS=1
# Chờ lấy connection từ pool tối đa bao lâu (nên < API_TIMEOUT_MS)
DB_POOL_ACQUIRE_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_SECS=600
DB_POOL_MAX_LIFETIME_SECS=1800

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_RESPONSE_TIMEOUT_MS=2000

# ---- Hang realtime (WebSocket /ws) ----
# Số người tối đa trong hang; người đến sau chờ ngoài cửa (FIFO)
ROOM_CAPACITY=500
# Số người tối đa trong hàng chờ (quá thì từ chối kèm retryAfter)
QUEUE_MAX=3000
# Bot "người mồi" đi lại + chat mồi trong hang để không vắng (0 = tắt). Tự nhường chỗ khi hang gần đầy
ROOM_BOTS=15
# Chu kỳ gom & phát sự kiện di chuyển (ms)
ROOM_TICK_MS=100
# Số người tối đa được cho vào mỗi giây (rải đều theo tick)
ADMIT_PER_SEC=20
# Chat trong hang (chỉ hiển thị live, KHÔNG lưu): gom tin mỗi CHAT_FLUSH_MS rồi lọc từ cấm + phát 1 lần
CHAT_FLUSH_MS=250
# Tối đa số tin cả hang mỗi giây (quá thì báo người gửi chậm lại)
CHAT_MAX_PER_SEC=20
# (tuỳ chọn) file từ cấm bổ sung, mỗi dòng 1 từ/cụm từ — cộng thêm vào danh sách có sẵn trong binary
CHAT_BLACKLIST_FILE=
# Bắt chuyện (chat riêng 2 người), đơn vị ms:
#  TALK_INVITE_MS: người được mời có chừng này để trả lời (3000..120000; client đếm ngược theo số này)
#  TALK_ASK_GAP_MS: hai lần mời của một người cách nhau ít nhất
#  TALK_DECLINE_COOLDOWN_MS: bị từ chối ("Để sau") → không mời lại đúng người đó trong chừng này
#  TALK_IDLE_MS: không ai nhắn gì → tự kết thúc (≥ 60000)
#  TALK_DM_MIN_GAP_MS: khoảng cách tối thiểu giữa 2 tin riêng của một người
TALK_INVITE_MS=20000
TALK_ASK_GAP_MS=10000
TALK_DECLINE_COOLDOWN_MS=60000
TALK_IDLE_MS=600000
TALK_DM_MIN_GAP_MS=400
# Origin của FE được gọi API (CORS) và mở WebSocket, cách nhau dấu phẩy. Rỗng = mọi origin.
# vd: https://hangmu.online
CORS_ALLOW_ORIGINS=

# Câu hỏi vui ở cửa hang: cache cả bộ câu hỏi trong Redis + header cache trình duyệt (giây)
QUIZ_CACHE_SECS=300

# Telegram (thông báo "X đã tham gia Tele" lên màn hình cả hang). Token trống = tắt.
# Bot @hangmu_bot phải là ADMIN của group mới nhận được sự kiện có người vào.
# MỖI token chỉ một nơi được đọc cập nhật (long polling): dev và production chạy cùng lúc với
# cùng token sẽ tranh nhau (lỗi 409) → khi production đã chạy, để trống token ở dev hoặc dùng bot khác.
# Chat ID đổi sang dạng -100… nếu group được Telegram nâng thành supergroup.
# Thử ở dev: điền token + chat id, nhờ một tài khoản khác vào group → mọi người trong hang thấy thông báo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Link mời hiển thị trên web (https://t.me/+...)

# ---------- Tài khoản khách + giữ chỗ khi rớt mạng (docs/guest-session.md) ----------
# Cookie HttpOnly hm_sid → Redis hangmu:guest:<sha256>. Secure tự bật khi APP_ENV=production.
# Giữ chỗ trong hang khi người có tài khoản rớt kết nối (giây, 5..300)
RECONNECT_HOLD_SECS=30
# TTL tài khoản khách trong Redis, gia hạn mỗi lần vào hang (ngày)
GUEST_TTL_DAYS=14
# Max-Age cookie hm_sid (ngày, ≤ 400, ≥ GUEST_TTL_DAYS — để bằng nhau), gia hạn mỗi lần mở Home
GUEST_COOKIE_DAYS=14
# Trần số tài khoản mới toàn hệ thống / phút (chặn spam làm phình Redis; vượt → vào hang kiểu khách)
GUEST_CREATE_PER_MIN=2000
