# ============================================================
# Hang MU — FRONTEND (Vite dev + Nginx container)
# Copy thành `frontend/.env` rồi chỉnh. KHÔNG commit `.env`.
# Docker: docker run --env-file frontend/.env ...
#
# Không có biến VITE_* → không biến nào bị bundle vào JS.
# Giá trị runtime cho trình duyệt đi qua /env.js (window.__ENV__).
# ============================================================

# ---- Timeout chung cho HTTP API (ms) ----
# PHẢI khớp với API_TIMEOUT_MS trong backend/.env
API_TIMEOUT_MS=10000

# ---- Dev (Vite) ----
FRONTEND_DEV_PORT=5173
# Backend mà Vite dev server proxy /api và /ws tới
BACKEND_URL=http://localhost:8080

# ---- Nginx (container production) ----
DOMAIN=localhost
# URL công khai (có scheme, không có / cuối) — dùng cho canonical, og:url, og:image.
# Bỏ trống thì nginx dùng https://${DOMAIN}; dev mặc định http://localhost:${FRONTEND_DEV_PORT}.
SITE_URL=
# DNS resolver cho proxy nguồn ngoài (/ext/espn). Trống = tự lấy nameserver của container.
NGINX_RESOLVER=
# Header chứa IP thật của người dùng (sau Cloudflare). Không dùng Cloudflare: X-Real-IP.
REAL_IP_HEADER=CF-Connecting-IP
# Gốc URL backend cho trình duyệt (vd https://api.hangmu.online). Rỗng = cùng domain qua /api, /ws.
API_URL=
# Link group Telegram (https://t.me/...) — nút mời vào group ở Home + trong hang. Rỗng = ẩn nút.
TELEGRAM_URL=
# Google Tag Manager (GTM-XXXXXXX). Rỗng = không tải GTM (để trống khi dev cho khỏi lẫn số liệu).
GTM_ID=
