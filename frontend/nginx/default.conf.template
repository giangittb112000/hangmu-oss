
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
real_ip_header ${REAL_IP_HEADER};

proxy_cache_path /var/cache/nginx/espn keys_zone=espn:1m max_size=10m inactive=10m use_temp_path=off;

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;
    server_tokens off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml image/x-icon model/gltf+json;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /env.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 "window.__ENV__ = { apiTimeoutMs: ${API_TIMEOUT_MS}, apiUrl: \"${API_URL}\", telegramUrl: \"${TELEGRAM_URL}\", gtmId: \"${GTM_ID}\" };\n";
    }

    location = /version.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /api/ {
        default_type application/json;
        return 404 '{"error":"API không phục vụ ở domain này — dùng API_URL"}';
    }
    location = /ws {
        return 404;
    }

    location /ext/espn/ {
        limit_except GET { deny all; }
        resolver ${NGINX_RESOLVER} valid=300s ipv6=off;
        resolver_timeout 3s;
        set $espn_host site.api.espn.com;
        rewrite ^/ext/espn/(.*)$ /apis/site/v2/sports/soccer/$1 break;
        proxy_pass https://$espn_host;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $espn_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_set_header Host $espn_host;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header User-Agent "Mozilla/5.0 (compatible; HangMU/1.0)";
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_hide_header Set-Cookie;
        proxy_cache espn;
        proxy_cache_valid 200 5s;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Cache $upstream_cache_status always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /models/ {
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        sub_filter '__SITE_URL__' '${SITE_URL}';
        sub_filter_once off;
        try_files $uri $uri/ /index.html;
    }
}
